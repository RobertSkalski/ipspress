RewriteEngine On

# 1. Wymuszenie bezpiecznego protokołu HTTPS oraz domeny z WWW
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.ipspress.com/$1 [L,R=301]

# 2. Usuwanie rozszerzeń .html z adresów URL (czyste linki typu /login, /about-us)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]
